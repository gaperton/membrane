{
  "openapi": "3.1.0",
  "info": {
    "title": "Membrane API",
    "description": "REST API for Membrane",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "description": "Service health status"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Check service health",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
